# Variables de entorno de Cerra Labs.
#
# Las usa el endpoint /api/contact. Mientras estén en PENDIENTE el formulario
# valida los campos pero responde que todavía no está operativo, en vez de
# perder la solicitud en silencio.
#
# NUNCA poner valores reales en este archivo ni en el repositorio. Los valores
# van en Vercel, en Settings > Environment Variables.

# Fase RD3 — notificaciones de lead por Telegram.
# El token lo devuelve BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=PENDIENTE

# Fase RD3 — destinatario de las notificaciones.
# Se obtiene escribiendo "hola" al bot y consultando getUpdates. No usar
# UserInfoBot: devuelve un id que falla con "chat not found".
TELEGRAM_CHAT_ID=PENDIENTE

# Fase RD3 — email de respaldo del lead, en paralelo a Telegram.
RESEND_API_KEY=PENDIENTE

# Fase RD3 — dirección donde llegan los avisos de lead por email.
LEAD_NOTIFICATION_EMAIL=PENDIENTE

# Fase RD3 — remitente del email. Opcional: si se deja vacío se usa el
# remitente compartido de Resend (onboarding@resend.dev). Al verificar el
# dominio, cambiar a algo como "Cerra Labs <avisos@cerralabs.com>".
RESEND_FROM=
