---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND, SITE_URL } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Nodos JSON-LD adicionales que se fusionan en el @graph del sitio. */
  schema?: Record<string, unknown>[];
  /** Excluye la página del índice: solo para páginas de confirmación. */
  noindex?: boolean;
  /** Migas de pan. La Home se añade sola; pasa solo los tramos siguientes. */
  breadcrumbs?: { label: string; href: string }[];
}

const {
  title,
  description,
  schema = [],
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href.replace(/\/$/, '') || SITE_URL;
const fullTitle = `${title} | ${BRAND.name}`;

const graph = [
  {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: BRAND.name,
    legalName: BRAND.legalName,
    url: SITE_URL,
    logo: `${SITE_URL}${BRAND.logo}`,
    description:
      'Agencia de closing B2B que aporta closers vetados a empresas que ya generan leads calificados, con modelo de rev-share sin cuota de entrada.',
    email: BRAND.email,
    areaServed: BRAND.country,
    ...(BRAND.sameAs.length ? { sameAs: BRAND.sameAs } : {}),
  },
  {
    '@type': 'ProfessionalService',
    '@id': `${SITE_URL}/#service`,
    name: BRAND.name,
    url: SITE_URL,
    parentOrganization: { '@id': `${SITE_URL}/#organization` },
    description:
      'Servicio externalizado de cierre de ventas B2B para agencias, SaaS, infoproductores y clínicas privadas con procesos de venta consultiva.',
    serviceType: 'Closing de ventas B2B',
    areaServed: BRAND.country,
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceUrl: `${SITE_URL}/contacto`,
      name: 'Llamada de diagnóstico',
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    url: SITE_URL,
    name: BRAND.name,
    inLanguage: 'es-ES',
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
  ...(breadcrumbs.length
    ? [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: [{ label: 'Inicio', href: '/' }, ...breadcrumbs].map(
            (crumb, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: crumb.label,
              item: new URL(crumb.href, SITE_URL).href,
            })
          ),
        },
      ]
    : []),
  ...schema,
];

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={`${SITE_URL}${BRAND.ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BRAND.name} — ${BRAND.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE_URL}${BRAND.ogImage}`} />

    <link rel="icon" type="image/svg+xml" href={BRAND.mark} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
