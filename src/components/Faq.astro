---
interface Props {
  title?: string;
  items: { q: string; a: string }[];
}

const { title = 'Preguntas frecuentes', items } = Astro.props;
---

<section class="section section-alt">
  <div class="wrap">
    <h2>{title}</h2>
    <div class="faq">
      {
        items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* El titulo se alinea con el resto de la pagina y solo la lista se limita en
     ancho, para que las respuestas no den lineas demasiado largas. */
  .faq {
    margin-top: 2rem;
    max-width: 62rem;
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    padding: 1.1rem 2rem 1.1rem 0;
    cursor: pointer;
    font-weight: 500;
    list-style: none;
    position: relative;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    position: absolute;
    right: 0.4rem;
    top: 1.55rem;
    width: 9px;
    height: 9px;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }

  details[open] summary::after {
    transform: rotate(-135deg);
  }

  details p {
    margin: 0 0 1.2rem;
    color: var(--ink-soft);
    max-width: 68ch;
  }
</style>
