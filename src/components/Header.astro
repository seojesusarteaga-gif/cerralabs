---
import { BRAND, NAV } from '../config/site';
import CtaButton from './CtaButton.astro';

const path = Astro.url.pathname.replace(/\/$/, '');
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${BRAND.name} — inicio`}>
      <img src={BRAND.logo} alt={BRAND.name} width="176" height="38" />
    </a>

    <input type="checkbox" id="nav-toggle" class="sr-only" />
    <label for="nav-toggle" class="nav-burger">
      <span aria-hidden="true"></span>
      <span class="sr-only">Abrir menú</span>
    </label>

    <nav class="site-nav" aria-label="Navegación principal">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <CtaButton compact />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(160%) blur(8px);
    border-bottom: 1px solid var(--line-soft);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand img {
    display: block;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .site-nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }

  .nav-burger {
    display: none;
  }

  @media (max-width: 1060px) {
    .nav-burger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .nav-burger span[aria-hidden] {
      width: 17px;
      height: 9px;
      border-top: 1.5px solid var(--ink);
      border-bottom: 1.5px solid var(--ink);
    }

    .site-nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: 0.75rem;
    }

    #nav-toggle:checked ~ .site-nav {
      display: flex;
    }

    .site-nav a {
      padding: 0.7rem 0;
      border-top: 1px solid var(--line-soft);
      font-size: 1rem;
    }

    .site-nav :global(.btn) {
      margin-top: 0.9rem;
    }
  }
</style>
