---
import { LEADS_OPCIONES, TICKET_OPCIONES } from '../config/site';

interface Props {
  /**
   * Parámetros de campaña de la URL, ya filtrados y serializados por la
   * página. Viaja en un campo oculto porque el sitio no ejecuta JavaScript:
   * la única forma de que el dato llegue al aviso es que lo lleve el propio
   * envío del formulario.
   */
  utm?: string;
}

const { utm = '' } = Astro.props;

/**
 * Formulario de la landing de campaña. POST nativo a /api/landing.
 *
 * Pide lo que decide el encaje en esta campaña —qué vende, ticket y volumen—
 * y nada más. Cada campo de más es un envío menos.
 */
---

<form class="formulario" method="POST" action="/api/landing">
  <div class="campos">
    <p class="campo">
      <label for="nombre">Nombre <span aria-hidden="true">*</span></label>
      <input
        type="text"
        id="nombre"
        name="nombre"
        required
        minlength="2"
        maxlength="100"
        autocomplete="name"
      />
    </p>

    <p class="campo">
      <label for="empresa">Empresa <span aria-hidden="true">*</span></label>
      <input
        type="text"
        id="empresa"
        name="empresa"
        required
        minlength="2"
        maxlength="150"
        autocomplete="organization"
      />
    </p>

    <p class="campo">
      <label for="email">Email <span aria-hidden="true">*</span></label>
      <input
        type="email"
        id="email"
        name="email"
        required
        maxlength="200"
        autocomplete="email"
        placeholder="nombre@empresa.com"
      />
    </p>

    <p class="campo">
      <label for="telefono">Teléfono <span aria-hidden="true">*</span></label>
      <input
        type="tel"
        id="telefono"
        name="telefono"
        required
        maxlength="30"
        pattern="[0-9+ \(\)\.\-]{9,30}"
        title="Un número de teléfono, con prefijo si no es español"
        autocomplete="tel"
        inputmode="tel"
        placeholder="600 000 000"
      />
    </p>

    <p class="campo">
      <label for="ticket">Ticket medio <span class="opt">opcional</span></label>
      <select id="ticket" name="ticket">
        <option value="">Prefiero no decirlo</option>
        {TICKET_OPCIONES.map((o) => <option value={o}>{o}</option>)}
      </select>
    </p>

    <p class="campo">
      <label for="leads">
        Oportunidades cualificadas <span class="opt">opcional</span>
      </label>
      <select id="leads" name="leads">
        <option value="">Prefiero no decirlo</option>
        {LEADS_OPCIONES.map((o) => <option value={o}>{o}</option>)}
      </select>
    </p>

    <p class="campo campo-ancho">
      <label for="web">Página web <span class="opt">opcional</span></label>
      <input
        type="text"
        id="web"
        name="web"
        maxlength="200"
        autocomplete="url"
        placeholder="tuempresa.com"
      />
    </p>

    <p class="campo campo-ancho">
      <label for="mensaje">
        ¿Qué vendes y en qué necesitas ayuda? <span aria-hidden="true">*</span>
      </label>
      <textarea id="mensaje" name="mensaje" required minlength="10" maxlength="3000" rows="5"
      ></textarea>
      <span class="ayuda">
        Con dos o tres líneas basta. Si conoces tu ratio de cierre actual o la
        duración de tu ciclo de venta, inclúyelos: ahorran media llamada.
      </span>
    </p>
  </div>

  {/* Parámetros de campaña. Oculto, no editable, informado en /privacidad. */}
  <input type="hidden" name="utm" value={utm} />

  {/* Honeypot: invisible para personas, tentador para bots. */}
  <p class="botcheck" aria-hidden="true">
    <label for="botcheck-landing">No rellenes este campo</label>
    <input type="text" id="botcheck-landing" name="botcheck" tabindex="-1" autocomplete="off" />
  </p>

  <div class="acciones">
    <button type="submit" class="btn">Solicitar llamada de diagnóstico</button>
    <p class="nota">
      Te respondemos en un día laborable. Si no encajas, también te lo decimos.
    </p>
  </div>

  <p class="legal">
    Al enviar este formulario aceptas nuestra{' '}
    <a href="/privacidad">política de privacidad</a>. Usamos tus datos
    únicamente para responder a tu solicitud y acordar la llamada.
  </p>
</form>

<style>
  .formulario {
    margin-top: 2rem;
  }

  .campos {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 700px) {
    .campos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .campo-ancho {
      grid-column: 1 / -1;
    }
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
  }

  label {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  label span[aria-hidden] {
    color: var(--muted);
    font-weight: 400;
  }

  .opt {
    color: var(--muted);
    font-weight: 400;
    font-size: 0.875rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.5;
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--muted);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  /* El aviso de campo inválido solo aparece tras intentar enviar, no mientras
     se escribe: marcar en rojo un campo a medio rellenar es hostil. */
  input:user-invalid,
  select:user-invalid,
  textarea:user-invalid {
    border-color: #c0504a;
  }

  .ayuda {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .botcheck {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
  }

  .nota {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .legal {
    margin: 1.25rem 0 0;
    max-width: 62ch;
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
