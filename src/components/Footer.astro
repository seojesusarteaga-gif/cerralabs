---
import { BRAND, FOOTER_EXTRA, FOOTER_SERVICIO, LEGAL, REDES_PIE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src={BRAND.logo} alt={BRAND.name} width="176" height="38" />
      <p class="muted">
        Cerramos ventas para empresas B2B que ya generan leads cualificados.
        Modelo de rev-share: cobramos un porcentaje del importe cobrado de lo
        que cerramos.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Servicio">
      <h2>Servicio</h2>
      {FOOTER_SERVICIO.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <nav class="footer-nav" aria-label="Más">
      <h2>Más</h2>
      {FOOTER_EXTRA.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer-nav">
      <h2>Contacto</h2>
      <p class="footer-email"><a href={`mailto:${BRAND.email}`}>{BRAND.email}</a></p>
      <p class="muted">España · Trabajo en remoto</p>

      <nav class="footer-social" aria-label="Redes sociales">
        <h3>Síguenos</h3>
        {REDES_PIE.map((r) => (
          <a href={r.url} rel={r.personal ? 'me noopener' : 'noopener'} target="_blank">
            {r.etiqueta}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="wrap footer-legal">
    <p class="muted">© {year} {BRAND.name}</p>
    <nav class="footer-legal-nav" aria-label="Legal">
      {LEGAL.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <p class="muted">
      Las condiciones económicas concretas se fijan por escrito en cada acuerdo.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--paper-alt);
    padding-block: clamp(2.5rem, 5vw, 3.5rem) 1.75rem;
    margin-top: 0;
  }

  .footer-inner {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 760px) {
    .footer-inner {
      grid-template-columns: 1.6fr repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  .footer-brand img {
    display: block;
    margin-bottom: 1rem;
  }

  .footer-brand p {
    max-width: 34ch;
    font-size: 0.9375rem;
    margin: 0;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .footer-nav h2 {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.3rem;
  }

  .footer-nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .footer-nav a:hover {
    color: var(--ink);
  }

  .footer-nav p {
    margin: 0;
    font-size: 0.9375rem;
  }

  .footer-email {
    word-break: break-word;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .footer-legal p {
    margin: 0;
    font-size: 0.875rem;
  }

  .footer-legal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }

  .footer-social {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  .footer-social h3 {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    margin: 0;
  }

  .footer-legal-nav a {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .footer-legal-nav a:hover {
    color: var(--ink);
  }
</style>
