---
import CtaButton from './CtaButton.astro';

interface Props {
  title?: string;
  body?: string;
  vertical?: string;
  label?: string;
}

const {
  title = 'Vemos tus números antes de proponerte nada',
  body = 'Treinta minutos. Revisamos tu volumen de leads, tu ratio de cierre actual y tu ticket medio. Si no encajas, te lo decimos en la misma llamada y te ahorramos el proceso.',
  vertical,
  label = 'Solicita tu diagnóstico',
} = Astro.props;
---

<section class="section cta-band">
  <div class="wrap wrap-narrow cta-inner">
    <h2>{title}</h2>
    <p class="lede">{body}</p>
    <CtaButton vertical={vertical} label={label} />
  </div>
</section>

<style>
  .cta-band {
    background: var(--ink);
    color: #fff;
  }

  .cta-inner {
    text-align: center;
  }

  .cta-inner h2 {
    color: #fff;
  }

  .cta-inner p {
    color: #c8ccd4;
    margin-inline: auto;
    margin-bottom: 1.8rem;
    max-width: 60ch;
  }

  .cta-inner :global(.btn) {
    background: #fff;
    color: var(--ink);
    border-color: #fff;
  }

  .cta-inner :global(.btn:hover) {
    background: #e8eaee;
    color: var(--ink);
  }
</style>
