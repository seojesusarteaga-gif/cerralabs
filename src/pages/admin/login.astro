---
import AdminLayout from '../../layouts/AdminLayout.astro';

export const prerender = false;

/**
 * Acceso al panel.
 *
 * El formulario hace POST directo al endpoint de Better Auth, sin JavaScript.
 * Better Auth responde con 302 al valor de callbackURL cuando las credenciales
 * son correctas, y devuelve al login con un parámetro de error cuando no.
 */
const error = Astro.url.searchParams.get('error');

const MENSAJES: Record<string, string> = {
  credenciales: 'Email o contraseña incorrectos.',
  faltan: 'Rellena los dos campos.',
};
const mensaje = error ? (MENSAJES[error] ?? 'No se ha podido iniciar sesión.') : null;
---

<AdminLayout title="Acceso">
  <section class="acceso">
    <div class="caja">
      <h1>Acceso al panel</h1>
      <p class="muted">Solo para el equipo de Cerra Labs.</p>

      {mensaje && <p class="error" role="alert">{mensaje}</p>}

      <form method="POST" action="/api/admin/entrar">
        <p class="campo">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="username"
            autofocus
          />
        </p>
        <p class="campo">
          <label for="password">Contraseña</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="12"
            autocomplete="current-password"
          />
        </p>
        <button type="submit" class="btn">Entrar</button>
      </form>
    </div>
  </section>
</AdminLayout>

<style>
  .acceso {
    display: grid;
    place-items: start center;
    padding: clamp(2.5rem, 8vw, 5rem) 1.25rem;
  }

  .caja {
    width: 100%;
    max-width: 26rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background: var(--paper);
  }

  h1 {
    font-size: var(--step-2);
    margin-bottom: 0.35rem;
  }

  .caja > .muted {
    font-size: 0.9375rem;
    margin-bottom: 1.75rem;
  }

  .error {
    background: #fdeceb;
    border: 1px solid #f3c7c4;
    border-radius: var(--radius);
    padding: 0.7rem 0.9rem;
    font-size: 0.9375rem;
    color: #8f2f28;
    margin-bottom: 1.25rem;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0 0 1.1rem;
  }

  label {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  input {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .btn {
    width: 100%;
    margin-top: 0.4rem;
  }
</style>
