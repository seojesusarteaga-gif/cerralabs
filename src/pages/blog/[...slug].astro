---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE_URL, VERTICALS } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const crumbs = [
  { label: 'Blog', href: '/blog' },
  { label: post.data.metaTitle ?? post.data.title, href: `/blog/${post.id}` },
];

const related = (await getCollection('blog'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${SITE_URL}/blog/${post.id}#post`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    inLanguage: 'es-ES',
    author: { '@id': `${SITE_URL}/#organization` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/${post.id}`,
  },
];
---

<BaseLayout
  title={post.data.metaTitle ?? post.data.title}
  description={post.data.description}
  schema={schema}
  breadcrumbs={crumbs}
>
  <Breadcrumbs items={crumbs} />

  <article class="section post">
    <div class="wrap wrap-narrow">
      <p class="meta muted">
        <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{post.data.readingTime} de lectura</span>
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="prose">
        <Content />
      </div>

      <aside class="next">
        <h2>Si esto te ha resonado</h2>
        <p>
          En Cerra Labs cerramos las ventas de empresas B2B que ya generan leads
          calificados, cobrando solo un porcentaje de lo que se cierra.
          <a href="/servicio">Así trabajamos</a>, y estos son los perfiles con
          los que encajamos:
        </p>
        <ul class="verts">
          {
            VERTICALS.map((v) => (
              <li>
                <a href={`/${v.slug}`}>{v.nav}</a>
              </li>
            ))
          }
        </ul>
      </aside>

      {
        related.length > 0 && (
          <aside class="related">
            <h2>Seguir leyendo</h2>
            <ul>
              {related.map((p) => (
                <li>
                  <a href={`/blog/${p.id}`}>{p.data.title}</a>
                  <span class="muted">{p.data.description}</span>
                </li>
              ))}
            </ul>
            <p class="all">
              <a href="/blog">Ver todos los artículos</a>
            </p>
          </aside>
        )
      }
    </div>
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .post {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .meta a {
    color: var(--muted);
    text-decoration: none;
  }

  .meta a:hover {
    color: var(--ink);
  }

  .post h1 {
    font-size: var(--step-3);
    max-width: 24ch;
  }

  .post > div > .lede {
    max-width: 62ch;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2rem;
  }

  .prose :global(h2) {
    font-size: var(--step-2);
    margin-top: 2.5rem;
  }

  .prose :global(h3) {
    font-size: var(--step-1);
    margin-top: 2rem;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--ink-soft);
    max-width: 68ch;
  }

  .prose :global(ul) {
    padding-left: 1.15rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .next {
    margin-top: 3rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-alt);
  }

  .next h2 {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
  }

  .next p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .verts {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .verts a {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .verts a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .related {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .related h2 {
    font-size: var(--step-1);
  }

  .related ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 1rem;
  }

  .related li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .related li a {
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
  }

  .related li a:hover {
    color: var(--accent);
  }

  .related span {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .all {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
  }
</style>
