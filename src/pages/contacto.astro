---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import { BRAND, VERTICALS } from '../config/site';

const agenda = [
  {
    title: 'Primeros diez minutos',
    body: 'Tus números: volumen de leads, ratio de cierre actual, ticket y duración del ciclo.',
  },
  {
    title: 'Siguientes diez',
    body: 'Dónde se está perdiendo el dinero hoy y qué margen de mejora realista existe.',
  },
  {
    title: 'Últimos diez',
    body: 'Si encajamos, cómo sería el arranque y qué porcentaje aplicaría. Si no encajamos, te lo decimos aquí.',
  },
];

const crumbs = [{ label: 'Contacto', href: '/contacto' }];
---

<BaseLayout
  title="Contacto y llamada de diagnóstico"
  description="Escríbenos y revisamos tus números de cierre en una llamada de 30 minutos. Te decimos en la misma conversación si encajamos o no."
  schema={[]}
  breadcrumbs={crumbs}
>
  <Breadcrumbs items={crumbs} />
  <PageHero
    eyebrow="Contacto"
    title="Solicita tu llamada de diagnóstico"
    lede="Cuéntanos tu situación y te respondemos en un día laborable para fijar una llamada de treinta minutos. Sin coste y sin presentación comercial de cuarenta diapositivas."
    showCta={false}
  />

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <div class="form-col">
          <h2>Escríbenos</h2>
          <p class="muted intro">
            Los campos marcados con asterisco son obligatorios. El resto ayuda a
            que la primera llamada sea más útil, pero puedes dejarlo en blanco.
          </p>
          <ContactForm />
        </div>

        <aside class="side">
          <h2>Qué pasa después</h2>
          <ol class="agenda">
            {
              agenda.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </li>
              ))
            }
          </ol>
          <p class="muted">
            Si de la conversación se desprende que tu problema es de captación y
            no de cierre, te lo diremos y no habrá propuesta. Preferimos eso a
            venderte algo que no va a mover tu dato.
          </p>
          <p class="alt">
            ¿Prefieres el correo directo? <span class="email">{BRAND.email}</span>
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>Antes de escribir, revisa tu vertical</h2>
      <p class="lede v-lede">
        En cada página encontrarás el perfil de encaje concreto con los números a
        partir de los cuales esto funciona.
      </p>
      <div class="grid grid-4">
        {
          VERTICALS.map((v) => (
            <a class="card vcard" href={`/${v.slug}`}>
              <h3>{v.nav}</h3>
              <p>{v.fit}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 950px) {
    .contact-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .form-col h2 {
    font-size: var(--step-2);
  }

  .intro {
    max-width: 60ch;
    font-size: 0.9375rem;
    margin-bottom: 0;
  }

  .side {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
    background: var(--paper-alt);
  }

  .side h2 {
    font-size: var(--step-2);
  }

  .agenda {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    gap: 0;
  }

  .agenda li {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .agenda li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .agenda h3 {
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }

  .agenda p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .side > .muted {
    font-size: 0.9375rem;
    margin-bottom: 0;
  }

  .alt {
    margin: 1.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .email {
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .v-lede {
    max-width: 62ch;
  }

  .vcard {
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .vcard:hover {
    border-color: var(--ink);
    color: inherit;
  }

  .vcard h3 {
    font-size: 1.0625rem;
  }

  .vcard p {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0;
  }
</style>
